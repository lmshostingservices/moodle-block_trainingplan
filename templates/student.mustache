<div class="trainingplan">
<div class="ca-header"></div>

<div class="block_trainingplan-student">
  {{#hasplans}}
    <div class="trainingplan-outcome-legend">
      <strong>{{#str}} outcomelegend, block_trainingplan {{/str}}:</strong>
      <span>{{#str}} outcome_c, block_trainingplan {{/str}}</span>
      <span>{{#str}} outcome_ct, block_trainingplan {{/str}}</span>
      <span>{{#str}} outcome_rpl, block_trainingplan {{/str}}</span>
      <span>{{#str}} outcome_ip, block_trainingplan {{/str}}</span>
      <span>{{#str}} outcome_nys, block_trainingplan {{/str}}</span>
    </div>

    {{#plans}}
      <h4>{{cohortname}}</h4>

      <table class="table table-striped table-sm">
        <thead>
          <tr>
            <th>{{#str}} unitname, block_trainingplan {{/str}}</th>
            <th>{{#str}} type, block_trainingplan {{/str}}</th>
            <th>{{#str}} startdate, block_trainingplan {{/str}}</th>
            <th>{{#str}} durationdays, block_trainingplan {{/str}}</th>
            <th>{{#str}} duedate, block_trainingplan {{/str}}</th>
            <th>{{#str}} progress, block_trainingplan {{/str}}</th>
            <th>{{#str}} completed, block_trainingplan {{/str}}</th>
            <th>{{#str}} completiondate, block_trainingplan {{/str}}</th>
            <th>{{#str}} status, block_trainingplan {{/str}}</th>
          </tr>
        </thead>
        <tbody>
          {{#units}}
            <tr>
              <td>
                {{#canaccess}}<a href="{{uniturl}}">{{unitname}}</a>{{/canaccess}}
                {{^canaccess}}{{unitname}}{{/canaccess}}
              </td>
              <td>{{type}}</td>
              <td>{{startdate}}</td>
              <td>{{duration}}</td>
              <td>{{duedate}}</td>
              <td style="min-width:120px;">
                <div class="progress">
                  <div class="progress-bar" role="progressbar" style="width: {{progresswidth}}%;" aria-valuenow="{{progresswidth}}" aria-valuemin="0" aria-valuemax="100">
                    {{progress}}%
                  </div>
                </div>
              </td>
              <td>{{#completed}}{{#str}} yes {{/str}}{{/completed}}{{^completed}}{{#str}} no {{/str}}{{/completed}}</td>
              <td>{{completiondate}}</td>
              <td>{{statuslabel}}</td>
            </tr>
          {{/units}}
          {{^units}}
            <tr><td colspan="9">{{#str}} noplans, block_trainingplan {{/str}}</td></tr>
          {{/units}}
        </tbody>
      </table>

      {{#showsignbutton}}
        <button class="btn btn-primary tp-sign" data-cohortid="{{cohortid}}">Sign Plan</button>
      {{/showsignbutton}}

      <!-- Signature Modal -->
      <div id="tp-signature-modal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Sign Training Plan</h5>
              <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
              <p>Please draw your signature below:</p>
              <canvas id="tp-sign-canvas" style="border:1px solid #ccc; width:100%; height:150px;"></canvas>
              <div class="mt-2">
                <button class="btn btn-secondary" id="tp-clear-sign">Clear</button>
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn btn-primary" id="tp-save-sign">Save Signature</button>
            </div>
          </div>
        </div>
      </div>
      {{#signed}}
        <div class="mt-2 text-center">
          <strong>Signed on:</strong> {{signdate}}<br>
          {{#signature}}
            <img src="{{signature}}" alt="Signature" style="max-height: 80px; margin-top: 8px;">
          {{/signature}}
        </div>
      {{/signed}}
      <hr>
    {{/plans}}
  {{/hasplans}}

  
  
  {{^hasplans}}
    <div class="alert alert-info">{{#str}} noplans, block_trainingplan {{/str}}</div>
  {{/hasplans}}
</div>
</div>
{{#js}}
require(['jquery'], function($) {
  let currentCohort = null;
  const $modal = $('#tp-signature-modal');
  const canvas = document.getElementById('tp-sign-canvas');
  const ctx = canvas.getContext('2d');
  let drawing = false;

  function resizeCanvas() {
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width - 10; // small padding
    canvas.height = 150;
    ctx.lineWidth = 2;
    ctx.strokeStyle = '#000';
  }

  // 🔹 Initialize AFTER modal is shown (important)
  $modal.on('shown.bs.modal', function() {
    resizeCanvas();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  });

  // Clear signature
  $('#tp-clear-sign').on('click', function(e) {
    e.preventDefault();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  });

  // Drawing logic
  $(canvas).on('mousedown touchstart', function(e) {
    e.preventDefault();
    drawing = true;
    const pos = e.touches ? e.touches[0] : e;
    ctx.beginPath();
    ctx.moveTo(
      pos.clientX - canvas.getBoundingClientRect().left,
      pos.clientY - canvas.getBoundingClientRect().top
    );
  });

  $(canvas).on('mousemove touchmove', function(e) {
    if (!drawing) return;
    const pos = e.touches ? e.touches[0] : e;
    ctx.lineTo(
      pos.clientX - canvas.getBoundingClientRect().left,
      pos.clientY - canvas.getBoundingClientRect().top
    );
    ctx.stroke();
  });

  $(canvas).on('mouseup mouseleave touchend', function() {
    drawing = false;
  });

  // ✅ Show modal when "Sign Plan" clicked
  $('.tp-sign').on('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    currentCohort = $(this).data('cohortid');
    $modal.modal('show');
  });

  // ✅ Save signature and send to AJAX
  $('#tp-save-sign').on('click', function(e) {
    e.preventDefault();
    const signature = canvas.toDataURL('image/png');

    if (!signature || signature.length < 100) {
      alert('Please draw your signature before saving.');
      return;
    }

    $.post('{{ajaxsignurl}}', {
      sesskey: '{{sesskey}}',
      cohortid: currentCohort,
      signature: signature
    }, function(resp) {
      try {
        const data = JSON.parse(resp);
        if (data.status === 'ok') {
          $modal.modal('hide');
          location.reload();
        }
      } catch (err) {
        console.error('Signature save failed', err, resp);
        alert('Something went wrong saving your signature.');
      }
    });
  });
});
{{/js}}
